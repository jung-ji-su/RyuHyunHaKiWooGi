rules_version = '2';

// ✅ 이 규칙은 2026-11-26에 라이브에 배포됐다(uid 'jisu'/'hyunha'만 허용). 롤백: `git show 63f544d:storage.rules`(백업 ruleset a066294e).
//   firestore.rules 상단 주석 참고. 배포: `firebase deploy --only firestore:rules,storage`.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid in ['jisu', 'hyunha'];
    }
  }
}
