rules_version = '2';

// ✅ 이 규칙은 2026-11-26에 라이브에 배포됐다(uid 'jisu'/'hyunha'만 허용, authAttempts 차단).
//   - 이전 임시본(로그인만 요구)으로 되돌리려면 `git show 63f544d:firestore.rules` 내용으로 배포한다(백업 ruleset 4f09a06d).
//   - 2026-11-23의 첫 배포 시도(한글 uid)는 데이터가 안 보여 롤백했다. 한글 uid는 원인이 아니었고 옛 번들 기기가 유력(CLAUDE.md 참고).
//   - 수정 후 배포 전: `firebase emulators:exec --only firestore --project demo-rules "node rules-test.mjs"`(JDK 21).
//   - 배포: `firebase deploy --only firestore:rules,storage`. deploy.js는 `--only hosting,functions`라 규칙은 자동으로 나가지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null && request.auth.uid in ['jisu', 'hyunha'];
    }

    // 로그인 시도 제한 카운터: 클라이언트 접근 전면 차단(Cloud Function의 Admin SDK만 다룬다)
    match /authAttempts/{userId} {
      allow read, write: if false;
    }

    // 그 외 모든 컬렉션(하위 컬렉션 포함)은 두 사람만 읽기/쓰기. authAttempts는 여기서 제외한다.
    match /{col}/{rest=**} {
      allow read, write: if col != 'authAttempts' && isCouple();
    }
  }
}
